class Solution(object):
    def myAtoi(self, s):
        # 1. Remove leading/trailing whitespace
        s = s.strip()
        if not s:
            return 0
        
        sign = 1
        index = 0
        
        # 2. Check for the sign
        if s[0] == '-':
            sign = -1
            index += 1
        elif s[0] == '+':
            index += 1
            
        # 3. Extract numeric digits
        res = 0
        while index < len(s) and s[index].isdigit():
            res = res * 10 + int(s[index])
            index += 1
            
        # 4. Apply sign and handle 32-bit integer overflow
        res *= sign
        INT_MIN, INT_MAX = -2147483648, 2147483647
        
        if res < INT_MIN:
            return INT_MIN
        if res > INT_MAX:
            return INT_MAX
            
        return res
