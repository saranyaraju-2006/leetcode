class Solution(object):
    def convert(self, s, numRows):
        # Edge case: If only one row or string is too short, no zigzag happens
        if numRows == 1 or numRows >= len(s):
            return s

        # Create a list of strings, one for each row
        rows = [''] * numRows
        current_row = 0
        going_down = False

        for char in s:
            rows[current_row] += char
            
            # Change direction when we hit the top or bottom row
            if current_row == 0 or current_row == numRows - 1:
                going_down = not going_down
            
            # Move up or down
            current_row += 1 if going_down else -1

        # Join all rows together to get the final string
        return "".join(rows)
